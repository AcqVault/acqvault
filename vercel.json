{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/deviations", "destination": "/api/deviations" },
    { "source": "/:source(rfo|r-dfars|far-companion|compass|afi-63-138|category-management)", "destination": "/api/hub?source=:source" },
    { "source": "/:source(rfo|r-dfars|far-companion|compass|afi-63-138|category-management)/part-:part", "destination": "/api/page?source=:source&part=:part" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.usaspending.gov https://zenquotes.io https://www.federalregister.gov; form-action 'self'" }
      ]
    }
  ]
}
