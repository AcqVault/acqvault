{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/deviations", "destination": "/api/deviations" },
    { "source": "/changes", "destination": "/api/changes" },
    { "source": "/study", "destination": "/api/study" },
    { "source": "/source-selection", "destination": "/api/study?view=srcsel" },
    { "source": "/48cons", "destination": "/api/study?view=48cons" },
    { "source": "/library", "destination": "/api/library" },
    { "source": "/what-is-the-rfo", "destination": "/api/explainer" },
    { "source": "/:source(rfo|r-dfars|far-companion|afi-63-138|category-management|fmr|ssp|pgi)", "destination": "/api/hub?source=:source" },
    { "source": "/:source(rfo|r-dfars|far-companion|afi-63-138|category-management|fmr|ssp|pgi)/part-:part", "destination": "/api/page?source=:source&part=:part" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    },
    {
      "source": "/output/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/pdfs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' https://api.usaspending.gov; form-action 'self'" }
      ]
    },
    {
      "source": "/48cons",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), browsing-topics=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' https://api.usaspending.gov; form-action 'self'" }
      ]
    }
  ]
}
